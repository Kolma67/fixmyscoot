```astro
---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config/site';
import { getCollection } from 'astro:content';
import { getBrandLogo, getBrandLogoFallback } from '../config/brands';
import home from '../data/home.json';

const scooters = (await getCollection('scooters'))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const fmtHuf = (n: number) => n.toLocaleString('hu-HU');

// LocalBusiness JSON-LD
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": SITE.name,
  "description": SITE.description,
  "url": SITE.url,
  "image": `${SITE.url}/images/og-default.jpg`,
  "telephone": SITE.phone,
  "email": SITE.email,
  "areaServed": [
    { "@type": "City", "name": "Budapest" },
    { "@type": "AdministrativeArea", "name": "Óbuda (III. kerület)" },
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": SITE.address.street,
    "addressLocality": SITE.address.city,
    "postalCode": SITE.address.zip,
    "addressCountry": SITE.address.country,
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": SITE.geo.latitude,
    "longitude": SITE.geo.longitude,
  },
  "priceRange": SITE.priceRange,
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "16:00",
      "closes": "18:00"
    },
  ],
  "knowsAbout": [
    "Ninebot elektromos roller javítás",
    "Kukirin roller szerviz",
    "Xiaomi-kompatibilis elektromos roller",
    "E-roller karbantartás"
  ],
};

// BreadcrumbList
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Főoldal", "item": SITE.url }],
};

// Gyakori kérdések
const faq = [
  {
    q: 'Milyen elektromos rollereket javítotok?',
    a: 'Ninebot, Kukirin és a legtöbb Xiaomi-kompatibilis (replika) modell javításával, karbantartásával és fejlesztésével foglalkozom. Ha bizonytalan vagy, hívj – megmondom, tudok-e segíteni.',
  },
  {
    q: 'Kell előre időpontot foglalni?',
    a: 'Ajánlott, hogy biztosan rád tudjak időt szánni. Az időpontfoglalás online, pár perc alatt kitölthető, és telefonon vagy e-mailben visszaigazolom.',
  },
  {
    q: 'Mennyibe kerül egy javítás?',
    a: 'Az árak roller-típusonként és szolgáltatásonként átláthatóan megtalálhatók a Szolgáltatások oldalon. Pontos árat mindig a diagnózis után mondok – csak azt cserélem, ami valóban szükséges.',
  },
  {
    q: 'Mennyi idő egy javítás?',
    a: 'Az egyszerűbb munkák (pl. gumicsere, fékállítás) gyakran akár aznap elkészülnek, az összetettebbek (pl. vezérlő, akkumulátor) egyeztetés szerint. A várható időtartam minden szolgáltatásnál fel van tüntetve.',
  },
  {
    q: 'Hol található a szerviz?',
    a: `A szerviz Budapesten, Óbudán (III. kerület) van: ${SITE.address.full}. Térkép és elérhetőségek a Kapcsolat oldalon.`,
  },
  {
    q: 'Foglalkoztok tuninggal és fejlesztéssel is?',
    a: 'Igen – akkumulátorépítés, teljesítménynövelés, szoftveres tuning, egyedi világítás és más fejlesztések is elérhetők. Részletek a Tuning oldalon, ajánlatot pedig a kapcsolati űrlapon kérhetsz.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
};
---

<Layout
  title="Elektromos roller szerviz Budapest – Ninebot, Kukirin, Xiaomi"
  description={SITE.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <!-- A fájl többi része változatlan -->

  <!-- ═══════════════════════ CONTACT SUMMARY ═══════════════════════ -->
  <section class="section" style="background:#F8FAFC;">
    <div class="container">
      <h2 style="font-size:clamp(1.5rem,4vw,2rem);font-weight:900;color:#1E293B;text-align:center;margin-bottom:2rem;">
        {home.contactTitle}
      </h2>

      <div style="display:grid;gap:1.5rem;" class="md:grid-contact">

        <!-- Info -->
        <div style="background:white;border-radius:1rem;border:1px solid #E2E8F0;padding:1.75rem;">
          <dl style="display:flex;flex-direction:column;gap:1rem;">
            {[
              { icon: '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>', label: 'Cím', value: SITE.address.full },
              { icon: '<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.13 1.18 2 2 0 012.11 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>', label: 'Telefon', value: SITE.phoneDisplay, href: `tel:${SITE.phone}` },

              // ⬇️ NYITVATARTÁS MÓDOSÍTVA
              {
                icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
                label: 'Nyitvatartás',
                value: 'H–P: 16:00–18:00  |  Szo–V: Zárva'
              },
            ].map(item => (
              <div style="display:flex;gap:0.875rem;align-items:flex-start;">
                <div style="width:36px;height:36px;border-radius:0.5rem;background:#EFF6FF;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1848A0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
                </div>

                <div>
                  <dt style="font-size:0.75rem;font-weight:600;color:#94A3B8;text-transform:uppercase;letter-spacing:0.05em;">
                    {item.label}
                  </dt>

                  <dd style="font-size:0.95rem;font-weight:600;color:#1E293B;margin-top:0.125rem;">
                    {item.href
                      ? <a href={item.href} style="color:#1848A0;text-decoration:none;">{item.value}</a>
                      : item.value}
                  </dd>
                </div>
              </div>
            ))}
          </dl>

          <div style="margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid #E2E8F0;display:flex;gap:0.75rem;flex-wrap:wrap;">
            <a href="/idopontfoglalas" class="btn-primary" style="flex:1;justify-content:center;min-width:140px;">
              Időpontot kérek
            </a>

            <a href="/kapcsolat" class="btn-secondary" style="flex:1;justify-content:center;min-width:140px;">
              Kapcsolat
            </a>
          </div>
        </div>

        <!-- Térkép -->
        <div style="border-radius:1rem;overflow:hidden;min-height:280px;border:1px solid #E2E8F0;">
          <iframe
            title="Fix My Scoot – térkép"
            src={SITE.mapEmbedUrl}
            width="100%"
            height="100%"
            style="border:0;min-height:280px;display:block;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen>
          </iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- A fájl további CSS/script része változatlan -->
</Layout>
```
